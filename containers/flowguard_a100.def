Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

# A100-friendly variant: pinned to CUDA 12.1 to match the cluster's A100 driver
# stack. Packages are otherwise identical to flowguard.def so feature extraction
# is bitwise comparable.

%post
    chmod 1777 /tmp
    export DEBIAN_FRONTEND=noninteractive
    export TMPDIR="/opt/tmp"
    export UV_CACHE_DIR="/opt/uv_cache"
    export UV_HTTP_TIMEOUT="600"
    export UV_LINK_MODE="copy"
    mkdir -p "${TMPDIR}" "${UV_CACHE_DIR}"

    apt-get update && apt-get install -y \
        python3.10 python3-dev python3-pip python3-venv \
        git wget curl ripgrep ninja-build pkg-config cmake build-essential \
        libgl1 libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.10 /usr/bin/python3
    ln -sf /usr/bin/python3.10 /usr/bin/python

    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    uv pip install --system --no-cache \
        --index-url https://download.pytorch.org/whl/cu121 \
        torch==2.4.1 torchvision==0.19.1

    uv pip install --system --no-cache \
        accelerate==0.34.2 transformers==4.46.3 \
        sentencepiece==0.2.0 tokenizers==0.20.3 datasets==3.0.1 \
        Pillow==10.4.0 numpy==1.26.4 scipy==1.13.1 \
        scikit-learn==1.5.2 pandas==2.2.3 pyarrow==17.0.0 tqdm==4.66.5 \
        einops==0.8.0 safetensors==0.4.5 peft==0.13.2 diffusers==0.31.0 \
        openai==1.55.3 anthropic==0.39.0 pytest==8.3.3 matplotlib==3.9.2 \
        seaborn==0.13.2 scikit-image==0.24.0 pyyaml==6.0.2 rich==13.9.4 \
        aiohttp==3.10.10 httpx==0.27.2 backoff==2.2.1

    cd /opt && git clone https://github.com/rank-and-file/filelock_workarounds.git || true

%environment
    export PATH="/root/.local/bin:$PATH"
    export SOFT_FILELOCK="${SOFT_FILELOCK:-1}"
    export PYTHONPATH="/opt/filelock_workarounds/soft_file_locks:/work/src:${PYTHONPATH:-}"
    export TOKENIZERS_PARALLELISM="false"

%runscript
    exec python3 "$@"
