Bootstrap: docker
From: nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%post
    chmod 1777 /tmp
    export DEBIAN_FRONTEND=noninteractive
    export TMPDIR="/opt/tmp"
    export UV_CACHE_DIR="/opt/uv_cache"
    export UV_HTTP_TIMEOUT="600"
    export UV_LINK_MODE="copy"

    mkdir -p "${TMPDIR}" "${UV_CACHE_DIR}"

    apt-get update && apt-get install -y \
        python3.10 \
        python3-dev \
        python3-pip \
        python3-venv \
        git \
        wget \
        curl \
        iproute2 \
        net-tools \
        lsof \
        procps \
        ripgrep \
        ninja-build \
        pkg-config \
        cmake \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*

    # nvidia-smi shim — bound paths differ between hosts.
    cat >/usr/local/bin/nvidia-smi <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
for candidate in \
  /usr/bin/nvidia-smi \
  /usr/local/nvidia/bin/nvidia-smi \
  /usr/lib/nvidia/current/nvidia-smi
do
  if [ -x "${candidate}" ]; then
    exec "${candidate}" "$@"
  fi
done
echo "nvidia-smi: not found in container (try Apptainer --nv)." >&2
exit 127
EOF
    chmod +x /usr/local/bin/nvidia-smi

    ln -sf /usr/bin/python3.10 /usr/bin/python3
    ln -sf /usr/bin/python3.10 /usr/bin/python

    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # CUDA 12.8 PyTorch — must match the CUDA runtime in this base image.
    uv pip install --system --no-cache \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.8.0 torchvision==0.23.0

    uv pip install --system --no-cache \
        accelerate==0.34.2 \
        transformers==4.46.3 \
        sentencepiece==0.2.0 \
        tokenizers==0.20.3 \
        datasets==3.0.1 \
        Pillow==10.4.0 \
        numpy==1.26.4 \
        scipy==1.13.1 \
        scikit-learn==1.5.2 \
        pandas==2.2.3 \
        pyarrow==17.0.0 \
        tqdm==4.66.5 \
        einops==0.8.0 \
        safetensors==0.4.5 \
        peft==0.13.2 \
        diffusers==0.31.0 \
        openai==1.55.3 \
        anthropic==0.39.0 \
        pytest==8.3.3 \
        matplotlib==3.9.2 \
        seaborn==0.13.2 \
        scikit-image==0.24.0 \
        pyyaml==6.0.2 \
        rich==13.9.4 \
        aiohttp==3.10.10 \
        httpx==0.27.2 \
        backoff==2.2.1

    # Soft file lock shim — /fast on the cluster does not support flock.
    cd /opt
    git clone https://github.com/rank-and-file/filelock_workarounds.git || true

%environment
    export PATH="/root/.local/bin:$PATH"
    export NO_PROXY="localhost,127.0.0.1"
    export no_proxy="localhost,127.0.0.1"
    export SOFT_FILELOCK="${SOFT_FILELOCK:-1}"
    export PYTHONPATH="/opt/filelock_workarounds/soft_file_locks:/work/src:${PYTHONPATH:-}"
    export TOKENIZERS_PARALLELISM="false"

%runscript
    exec python3 "$@"

%labels
    Version v1.0
    Description FlowGuard inference + detector container

%help
    Use --nv for GPU passthrough. Bind the repo at /work:
      apptainer exec --nv --bind .:/work flowguard.sif python -m flowguard.scripts.extract
